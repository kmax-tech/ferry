#!/bin/sh
# ferry's own gate before a commit: the four checks AGENTS.md asks for,
# each judged by its own exit code — no pipe in front of a verdict (a commit
# went in with pyright red because `pyright | tail` exited 0, 2026-10-07).
# Turn on once per clone:  git config core.hooksPath .githooks
# Escape hatch for a deliberate exception: git commit --no-verify
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
venv=.venv/bin
if [ ! -x "$venv/python" ]; then
    echo "pre-commit: no $venv/python — create it: python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'" >&2
    exit 1
fi
fail=0
run() {
    name=$1
    shift
    if ! out=$("$@" 2>&1); then
        echo "pre-commit: $name failed:" >&2
        printf '%s\n' "$out" | tail -25 >&2
        fail=1
    fi
}
run "ruff check" "$venv/ruff" check .
run "ruff format --check" "$venv/ruff" format --check .
run "pyright" "$venv/pyright"
run "pytest" "$venv/python" -m pytest -q -p no:warnings
if [ "$fail" -ne 0 ]; then
    echo "pre-commit: commit refused — fix the above (or --no-verify for a deliberate exception)" >&2
    exit 1
fi
echo "pre-commit: ruff, format, pyright, pytest green"
